# ===================================================================
# Firebase Cloud Functions Environment Variables (.env)
# Place your real credentials in functions/.env before deploying.
# ===================================================================

# OPTION A: Using Gmail App Password (Fastest & Free)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a 16-character App Password (e.g., 'abcd efgh ijkl mnop')
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# OPTION B: Using Resend (SMTP)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_1234567890abcdef
# SMTP_FROM=onboarding@resend.dev

# OPTION C: Using SendGrid (SMTP)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# SMTP_FROM="Camoniku" <noreply@yourdomain.com>
