rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Authentication & Identity Helpers
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // Notebook Membership & Ownership Helpers
    // =========================================================================
    function isNotebookMember(notebookId) {
      let nbPath = /databases/$(database)/documents/notebooks/$(notebookId);
      return isAuthenticated() &&
        exists(nbPath) &&
        (
          get(nbPath).data.owner_id == request.auth.uid ||
          request.auth.uid in get(nbPath).data.member_ids
        );
    }

    // =========================================================================
    // 1. Users Collection (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Anyone logged in can read user profiles to resolve collaborator names/emails
      allow read: if isAuthenticated();

      // Users can only write/update their own profile
      allow create, update: if isUser(userId);
      allow delete: if false;
    }

    // =========================================================================
    // 2. Notebooks Collection (/notebooks/{notebookId})
    // =========================================================================
    match /notebooks/{notebookId} {
      // GET: Allowed for authenticated users to inspect notebook details and accept invitations
      allow get: if isAuthenticated();

      // LIST: Exactly matches query where('member_ids', 'array-contains', request.auth.uid)
      allow list: if isAuthenticated() && (
        request.auth.uid in resource.data.member_ids
      );

      // CREATE: Authenticated user creating a notebook where they are the owner
      allow create: if isAuthenticated() &&
        request.resource.data.owner_id == request.auth.uid &&
        (request.auth.uid in request.resource.data.member_ids);

      // UPDATE:
      // Case A: Owner updating notebook metadata, currency, members, or pending_invites
      // Case B: An invited user joining the notebook by appending their own UID to member_ids
      allow update: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid ||
        (
          request.resource.data.owner_id == resource.data.owner_id &&
          request.auth.uid in request.resource.data.member_ids
        )
      );

      // DELETE: Only the notebook owner can delete the notebook
      allow delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
    }

    // =========================================================================
    // 3. Invitations Collection (/invitations/{invitationId})
    // =========================================================================
    match /invitations/{invitationId} {
      // GET: Anyone can fetch an invitation by ID (needed for public invite link preview)
      allow get: if true;

      // LIST: Logged-in users can list invitations where they are owner or invitee
      allow list: if isAuthenticated();

      // CREATE: Logged-in notebook owner can issue invitations
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;

      // UPDATE: Owner can revoke/update, OR invitee can accept/decline
      allow update: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid ||
        request.resource.data.accepted_by == request.auth.uid ||
        resource.data.invitee_email == request.auth.token.email
      );

      // DELETE: Owner can remove invitations
      allow delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
    }

    // =========================================================================
    // 4. Classifications Collection (/classifications/{classificationId})
    // =========================================================================
    match /classifications/{classificationId} {
      // READ (get, list): Allowed if the user is an owner/member of the notebook
      allow get, list: if isNotebookMember(resource.data.notebook_id);

      // CREATE: Allowed if user is creating for a notebook they belong to
      allow create: if isNotebookMember(request.resource.data.notebook_id);

      // UPDATE/DELETE: Allowed if user belongs to the notebook
      allow update, delete: if isNotebookMember(resource.data.notebook_id);
    }

    // =========================================================================
    // 5. Categories Collection (/categories/{categoryId})
    // =========================================================================
    match /categories/{categoryId} {
      // READ (get, list): Allowed if the user is an owner/member of the notebook
      allow get, list: if isNotebookMember(resource.data.notebook_id);

      // CREATE: Allowed if user is creating for a notebook they belong to
      allow create: if isNotebookMember(request.resource.data.notebook_id);

      // UPDATE/DELETE: Allowed if user belongs to the notebook
      allow update, delete: if isNotebookMember(resource.data.notebook_id);
    }

    // =========================================================================
    // 6. Transactions Collection (/transactions/{transactionId})
    // =========================================================================
    match /transactions/{transactionId} {
      // READ (get, list): Allowed if user is owner/member of the notebook
      allow get, list: if isNotebookMember(resource.data.notebook_id);

      // CREATE: Allowed if user belongs to the notebook and records under their own user_id
      allow create: if isNotebookMember(request.resource.data.notebook_id) &&
        request.resource.data.user_id == request.auth.uid;

      // UPDATE: Allowed if user belongs to the notebook
      allow update: if isNotebookMember(resource.data.notebook_id);

      // DELETE: Allowed if user is transaction creator or notebook owner/member
      allow delete: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isNotebookMember(resource.data.notebook_id)
      );
    }

  }
}
