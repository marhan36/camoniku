rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is owner of the notebook
    function isNotebookOwner(notebookData) {
      return isAuthenticated() && notebookData.owner_id == request.auth.uid;
    }

    // Check if user is a member or owner of the notebook
    function isNotebookMember(notebookData) {
      return isAuthenticated() && (
        notebookData.owner_id == request.auth.uid ||
        (notebookData.member_ids is list && request.auth.uid in notebookData.member_ids)
      );
    }

    // Lookup parent notebook data
    function getNotebookData(notebookId) {
      return get(/databases/$(database)/documents/notebooks/$(notebookId)).data;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false;
    }

    // Notebooks Collection
    match /notebooks/{notebookId} {
      // Anyone in member_ids or owner can read
      allow read: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid ||
        (resource.data.member_ids is list && request.auth.uid in resource.data.member_ids)
      );

      // Authenticated users can create notebook if they set themselves as owner
      allow create: if isAuthenticated() &&
        request.resource.data.owner_id == request.auth.uid &&
        (request.auth.uid in request.resource.data.member_ids);

      // Only Owner can update notebook details or member_ids, OR an authenticated user joining via invite
      allow update: if isAuthenticated() && (
        (isNotebookOwner(resource.data) && request.resource.data.owner_id == resource.data.owner_id) ||
        (
          request.resource.data.owner_id == resource.data.owner_id &&
          request.auth.uid in request.resource.data.member_ids
        )
      );

      // Only Owner can delete notebook
      allow delete: if isNotebookOwner(resource.data);
    }

    // Invitations Collection
    match /invitations/{invitationId} {
      allow get: if true;
      allow list, create, update, delete: if isAuthenticated();
    }

    // Mail Collection (Firebase Trigger Email Extension)
    match /mail/{mailId} {
      allow create, read: if isAuthenticated();
    }

    // Classifications Collection
    match /classifications/{classificationId} {
      allow read: if isAuthenticated() &&
        isNotebookMember(getNotebookData(resource.data.notebook_id));

      allow create: if isAuthenticated() &&
        isNotebookMember(getNotebookData(request.resource.data.notebook_id));

      allow update, delete: if isAuthenticated() &&
        isNotebookMember(getNotebookData(resource.data.notebook_id));
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated() &&
        isNotebookMember(getNotebookData(resource.data.notebook_id));

      allow create: if isAuthenticated() &&
        isNotebookMember(getNotebookData(request.resource.data.notebook_id));

      allow update, delete: if isAuthenticated() &&
        isNotebookMember(getNotebookData(resource.data.notebook_id));
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        isNotebookMember(getNotebookData(resource.data.notebook_id));

      allow create: if isAuthenticated() &&
        isNotebookMember(getNotebookData(request.resource.data.notebook_id)) &&
        request.resource.data.user_id == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
        isNotebookMember(getNotebookData(resource.data.notebook_id));
    }
  }
}
